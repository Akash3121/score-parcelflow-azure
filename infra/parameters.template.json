    "budgetContact": {
      "value": "<notification-email>"
    },
    "deployBudget": {
      "value": true
    },
    "nodeVmSize": {
      "value": "Standard_D2as_v7"
    },
    "postgresSkuName": {
      "value": "Standard_B1ms"
    }
